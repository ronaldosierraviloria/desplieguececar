{
    "openapi": "3.0.0",
    "info": {
        "title": "Sistema de Grado API",
        "description": "API para la gestión de trabajos de grado. Proporciona endpoints para administradores, gestores y evaluadores.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Servidor local"
        }
    ],
    "paths": {
        "/admin/estudiante/eliminar/{id}": {
            "delete": {
                "tags": [
                    "Admin"
                ],
                "summary": "Eliminar estudiante con motivo",
                "operationId": "8dcb8a9f17dae3839e1bd8f326d44241",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "motivo": {
                                        "description": "Motivo de la eliminación",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Estudiante eliminado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Motivo requerido"
                    },
                    "404": {
                        "description": "Estudiante no encontrado"
                    },
                    "500": {
                        "description": "Error al eliminar"
                    }
                }
            }
        },
        "/admin/trabajo-evaluador/prorrogar": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Prorrogar plazo de revisión",
                "description": "Prorroga el plazo de revisión para un evaluador de un trabajo específico.",
                "operationId": "86ed9b84fdb4dd290eb2e52a6a8ab5ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "id_trabajo": {
                                        "type": "integer"
                                    },
                                    "id_profesor": {
                                        "type": "integer"
                                    },
                                    "dias": {
                                        "description": "Días a prorrogar (1-90)",
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Plazo prorrogado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "nueva_fecha": {
                                            "type": "string"
                                        },
                                        "dias_restantes": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error al prorrogar"
                    }
                }
            }
        },
        "/admin/trabajo/{id}/aprobar": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Aprobar trabajo de grado",
                "description": "Aprueba oficialmente el trabajo de grado y registra el hito.",
                "operationId": "6686c74f3825c08cebb9961831b1f9e6",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "observacion_estado": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redirect con mensaje de éxito"
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    }
                }
            }
        },
        "/admin/trabajo/{id}/retirar": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Retirar o reactivar trabajo de grado",
                "operationId": "8fcca6390a9cd3a39c50f2b765430770",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect con mensaje de éxito"
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    }
                }
            }
        },
        "/admin/trabajo/{id}/eliminar": {
            "delete": {
                "tags": [
                    "Admin"
                ],
                "summary": "Eliminar trabajo de grado",
                "operationId": "182ffc8f5bfe947bb229e8d955bb6cda",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect con mensaje de éxito"
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    },
                    "422": {
                        "description": "El trabajo debe estar retirado primero"
                    }
                }
            }
        },
        "/trabajos/{id}/rubrica": {
            "get": {
                "tags": [
                    "Evaluador"
                ],
                "summary": "Obtener rúbrica de un trabajo",
                "operationId": "85b280a8712ba80955c0a7089770c495",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Criterios de la rúbrica",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "criterio": {
                                                "type": "string"
                                            },
                                            "puntaje_max": {
                                                "type": "number"
                                            },
                                            "calificacion": {
                                                "type": "number",
                                                "nullable": true
                                            },
                                            "comentario": {
                                                "type": "string"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    }
                }
            }
        },
        "/trabajos/{id}/guardar-evaluacion": {
            "post": {
                "tags": [
                    "Evaluador"
                ],
                "summary": "Guardar evaluación completa de un trabajo",
                "operationId": "c89bc16206eb64154a4cee3e62bc6dd3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "tipo_plantilla": {
                                        "type": "string",
                                        "enum": [
                                            "propuesta_de_grado",
                                            "pasantia",
                                            "trabajo_de_grado"
                                        ]
                                    },
                                    "nota_final": {
                                        "type": "number",
                                        "nullable": true
                                    },
                                    "resultado": {
                                        "type": "string"
                                    },
                                    "observaciones_globales": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "criterios": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "descripcion": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "calificacion": {
                                                    "type": "number",
                                                    "nullable": true
                                                },
                                                "comentario": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "valoracion": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "enum": [
                                                        "excelente",
                                                        "aceptable",
                                                        "deficiente"
                                                    ]
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "firma": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Evaluación guardada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "nota_final": {
                                            "type": "number"
                                        },
                                        "resultado": {
                                            "type": "string"
                                        },
                                        "evaluacion_completada": {
                                            "type": "boolean"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Evaluador no encontrado"
                    },
                    "403": {
                        "description": "Debe aceptar el trabajo primero"
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    }
                }
            }
        },
