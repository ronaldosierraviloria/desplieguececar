                                                "calificacion": {
                                                    "type": "number",
                                                    "nullable": true
                                                },
                                                "comentario": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "valoracion": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "enum": [
                                                        "excelente",
