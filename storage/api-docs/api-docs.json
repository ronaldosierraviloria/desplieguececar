                    "403": {
                        "description": "Debe aceptar el trabajo primero"
                    },
                    "404": {
                        "description": "Trabajo no encontrado"
                    }
                }
            }
        },
        "/evaluador/aceptar-terminos": {
            "post": {
                "tags": [
                    "Evaluador"
